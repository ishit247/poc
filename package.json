{
  "name": "cafeteria-pos",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test && node --test db/test/rls.test.mjs db/test/platform.test.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "up:fresh": "node scripts/up-fresh.mjs",
    "env:up": "node scripts/up.mjs",
    "env:down": "node scripts/down.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:quick": "node scripts/validate.mjs quick",
    "validate:standard": "node scripts/validate.mjs standard",
    "validate:full": "node scripts/validate.mjs full"
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
